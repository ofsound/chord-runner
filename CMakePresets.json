{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-xcode",
      "displayName": "macOS (Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/Builds-Xcode",
      "cacheVariables": {
        "CHORD_RUNNER_COPY_PLUGINS": "ON"
      }
    },
    {
      "name": "ios-xcode",
      "displayName": "iPhone and iPad (Xcode, iOS 15+)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/Builds-iOS",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CHORD_RUNNER_COPY_PLUGINS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-xcode",
      "configurePreset": "macos-xcode",
      "configuration": "Debug"
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-xcode",
      "configuration": "Debug",
      "targets": [
        "ChordRunner_Standalone"
      ],
      "nativeToolOptions": [
        "-sdk",
        "iphonesimulator",
        "-arch",
        "arm64",
        "CODE_SIGNING_ALLOWED=NO"
      ]
    }
  ]
}
